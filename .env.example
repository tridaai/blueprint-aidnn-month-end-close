# Copy this file to .env in the repo root and fill in only what you use.
# The app loads .env automatically at startup (API, CLI, and demo).
# A variable set in the real environment always takes precedence over .env.
#
# THE STANDARD RUN IS THE OFFLINE REFERENCE ENGINE — deliberately:
# aidnn publishes no public API, so there is no hosted endpoint to
# default to. In a customer deployment, FINANCE_ENGINE=aidnn with
# AIDNN_WORKSPACE_URL set to the workspace endpoint agreed with
# Isotopes during onboarding (see "The aidnn seam" in the README).
# The offline engine implements the same FinanceEnginePort over
# the local marts; tests, evals, and the demo run on it, and
# /readiness names it. Its answers are never served under aidnn's
# name: selecting aidnn without a workspace URL fails startup.

# Which finance engine to use: offline | aidnn
FINANCE_ENGINE=offline

# ---------------------------------------------------------------------------
# aidnn (FINANCE_ENGINE=aidnn)
# ---------------------------------------------------------------------------
# The endpoint of the customer's deployed aidnn workspace, as
# agreed during deployment. aidnn has no public API and no
# default URL — an FDE implements the defined-queries contract
# in engine_aidnn.py against this endpoint.
# AIDNN_WORKSPACE_URL=https://aidnn-workspace.internal.example
# Credential for that endpoint, where the deployment issues one.
# AIDNN_API_TOKEN=
# Per-request timeout (seconds) for workspace calls.
# AIDNN_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Definition pack (the customer's metric catalog)
# ---------------------------------------------------------------------------
# Path to a definition pack JSON. Unset = the bundled Harborlight
# pack. A customer deployment carries its own versioned pack.
# DEFINITION_PACK=/path/to/close_pack.json

# ---------------------------------------------------------------------------
# Production data services (set by docker-compose; unset = the
# in-memory test doubles, and /readiness says so)
# ---------------------------------------------------------------------------
# DATABASE_URL=<redacted>
# S3_ENDPOINT_URL=http://minio:8333
# S3_BUCKET=close-extracts
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
